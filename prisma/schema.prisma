generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN    @map("admin")
  CUSTOMER @map("cliente")
}

enum OrderStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  SHIPPED    @map("shipped")
  DELIVERED  @map("delivered")
  CANCELLED  @map("cancelled")
}

enum PaymentStatus {
  PENDING  @map("pending")
  PAID     @map("paid")
  FAILED   @map("failed")
  REFUNDED @map("refunded")
}

model User {
  id                     String    @id @default(cuid()) @db.VarChar(30)
  name                   String    @db.VarChar(120)
  email                  String    @unique @db.VarChar(254)
  passwordHash           String    @db.VarChar(255)
  role                   UserRole  @default(CUSTOMER)
  preferredAssistiveTech String?   @db.VarChar(120)
  highContrastDefault    Boolean   @default(false)
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  addresses              Address[]
  orders                 Order[]

  @@map("users")
}

model Address {
  id         String   @id @default(cuid()) @db.VarChar(30)
  userId     String   @db.VarChar(30)
  label      String   @db.VarChar(80)
  street     String   @db.VarChar(255)
  city       String   @db.VarChar(100)
  region     String   @db.VarChar(100)
  postalCode String   @db.VarChar(20)
  country    String   @default("Colombia") @db.VarChar(80)
  phone      String   @db.VarChar(30)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Product {
  id            String        @id @default(cuid()) @db.VarChar(100)
  name          String        @db.VarChar(180)
  category      String        @db.VarChar(60)
  categoryLabel String        @db.VarChar(100)
  shortCategory String        @db.VarChar(40)
  icon          String        @db.VarChar(80)
  price         Decimal       @db.Decimal(12, 2)
  priceType     String        @db.VarChar(100)
  image         String        @db.Text
  imageAlt      String        @db.Text
  badge         String        @db.VarChar(100)
  subBadge      String        @db.VarChar(100)
  description   String        @db.Text
  inStock       Boolean       @default(true)
  stockCount    Int           @default(0)
  isDownload    Boolean       @default(false)
  wcagLevel     String        @db.VarChar(40)
  inputMethod   String        @db.VarChar(40)
  featured      Boolean       @default(false)
  contrastRatio String?       @db.VarChar(30)
  warrantyInfo  String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  specs         ProductSpec[]
  orderItems    OrderItem[]

  @@index([category])
  @@map("products")
}

model ProductSpec {
  id        Int     @id @default(autoincrement())
  productId String  @db.VarChar(100)
  label     String  @db.VarChar(120)
  value     String  @db.Text
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, label])
  @@map("product_specs")
}

model Order {
  id               String        @id @default(cuid()) @db.VarChar(30)
  orderNumber      String        @unique @db.VarChar(30)
  userId           String?       @db.VarChar(30)
  customerName     String        @db.VarChar(120)
  customerEmail    String        @db.VarChar(254)
  totalAmount      Decimal       @db.Decimal(12, 2)
  currency         String        @default("COP") @db.Char(3)
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING)
  paymentMethod    String?       @db.VarChar(80)
  paymentReference String?       @db.VarChar(180)
  shippingAddress  String?       @db.Text
  shippingPhone    String?       @db.VarChar(30)
  deliveryNotes    String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            OrderItem[]

  @@index([customerEmail])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid()) @db.VarChar(30)
  orderId     String   @db.VarChar(30)
  productId   String?  @db.VarChar(100)
  productName String   @db.VarChar(180)
  unitPrice   Decimal  @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal  @db.Decimal(12, 2)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}