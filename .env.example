# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public HTTPS origin of the storefront/API, including the origin exposed by a local tunnel.
APP_URL="https://tu-dominio-publico.example"

# MySQL database used by the Express API.
DATABASE_URL="mysql://root:PASSWORD@localhost:3306/softtech_market"
SESSION_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Mercado Pago Checkout Pro. Keep the access token and webhook secret server-side.
# Use test credentials and sandbox mode while developing.
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
MP_ENVIRONMENT="sandbox"
